rules_version = '2';
// Paste into Firebase console > Firestore > Rules. Requires Anonymous sign-in enabled.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /incidents/{id}         { allow read: if true; allow write: if signedIn(); }
    match /sources/{id}           { allow read: if true; }
    match /stations/{id}          { allow read: if true; }
    match /vehicles/{id}          { allow read: if true; allow write: if signedIn(); }
    match /alerts/{id}            { allow read: if true; allow write: if signedIn(); }
    match /emergencyServices/{id} { allow read: if true; allow write: if signedIn(); }
    match /dispatches/{id}        { allow read: if true; allow create, update: if signedIn(); allow delete: if false; }
    match /auditLogs/{id}         { allow read: if true; allow create: if signedIn(); allow update, delete: if false; }

    match /emergencyContacts/{id} {
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid','name','phone','relation','source','createdAt','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.phone.matches('^\\+?[0-9]{6,15}$');
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.phone.matches('^\\+?[0-9]{6,15}$');
    }
  }
}
